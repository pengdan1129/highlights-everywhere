#!/usr/bin/env python3
"""
hl - Highlights Everywhere v2
A universal text highlight collector for macOS with color + comments + web UI.

Usage:
  hl [options] "text..."      Save highlighted text
  hl [options]                 Same, reads from clipboard if no args/stdin
  hl -c yellow "text..."       Save with color (yellow/green/blue/red/purple/orange/pink)
  hl -m "my note" "text..."    Save with comment/annotation
  hl -t "tag1,tag2" "text..."  Save with tags
  hl --url "https://..."       Save with source URL

  hl server                    Start the web UI (http://localhost:8899)
  hl search <query>            Search highlights via Spotlight
  hl list [N]                  List last N highlights (default 10)
  hl today                     Show today's highlights
  hl stats                     Show statistics
  hl open                      Open highlights directory in Finder
  hl -h / --help               Show this help

Colors: yellow, green, blue, red, purple, orange, pink
"""

import sys
import os
import re
import json
import subprocess
import datetime
import webbrowser
import http.server
import socketserver
import urllib.parse
from pathlib import Path
from collections import Counter

HIGHLIGHTS_DIR = Path.home() / "Highlights"
TAGS_DIR = HIGHLIGHTS_DIR / ".tags"
WEB_PORT = 8899

VALID_COLORS = {
    'yellow': '#FFF176',
    'green': '#A5D6A7',
    'blue': '#90CAF9',
    'red': '#EF9A9A',
    'purple': '#CE93D8',
    'orange': '#FFCC80',
    'pink': '#F48FB1',
}

def ensure_dirs():
    today = datetime.date.today()
    dir_path = HIGHLIGHTS_DIR / str(today.year) / f"{today.month:02d}"
    dir_path.mkdir(parents=True, exist_ok=True)
    TAGS_DIR.mkdir(parents=True, exist_ok=True)
    return dir_path


def get_frontmost_app():
    try:
        result = subprocess.run(
            ['osascript', '-e',
             'tell application "System Events" to get name of first application process whose frontmost is true'],
            capture_output=True, text=True, timeout=5
        )
        return result.stdout.strip() if result.returncode == 0 else "Unknown"
    except Exception:
        return "Unknown"


def get_clipboard():
    try:
        result = subprocess.run(['pbpaste'], capture_output=True, text=True, timeout=5)
        return result.stdout.strip() if result.returncode == 0 else ""
    except Exception:
        return ""


def notify(title, text):
    try:
        safe_title = title.replace('\\', '\\\\').replace('"', '\\"')
        safe_text = text.replace('\\', '\\\\').replace('"', '\\"')
        subprocess.run([
            'osascript', '-e',
            f'display notification "{safe_text}" with title "{safe_title}"'
        ], capture_output=True, timeout=5)
    except Exception:
        pass


def sanitize_filename(text, max_len=50):
    text = text.strip().strip('"\'〈《（')
    text = re.sub(r'[\\/:*?"<>|]', ' ', text)
    text = re.sub(r'\s+', ' ', text)
    if len(text) > max_len:
        text = text[:max_len].rsplit(' ', 1)[0] if ' ' in text[:max_len] else text[:max_len]
    return text.strip() or "untitled"


def hex_to_rgba(hex_color, alpha=0.3):
    """Convert hex color to rgba string."""
    h = hex_color.lstrip('#')
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"rgba({r},{g},{b},{alpha})"


def save_highlight(text, tags=None, color=None, comment=None, source_url=None):
    if not text or not text.strip():
        return None, "Nothing to save - no text provided"

    text = text.strip()
    tags = tags or []
    color = color or 'yellow'
    if color not in VALID_COLORS:
        print(f"Warning: '{color}' not valid, using yellow. Valid: {', '.join(VALID_COLORS.keys())}", file=sys.stderr)
        color = 'yellow'

    ts = datetime.datetime.now()
    timestamp_str = ts.strftime("%Y-%m-%d %H:%M:%S")
    date_str = ts.strftime("%Y-%m-%d")
    time_str = ts.strftime("%H:%M:%S")

    dir_path = HIGHLIGHTS_DIR / str(ts.year) / f"{ts.month:02d}"
    dir_path.mkdir(parents=True, exist_ok=True)

    ts_file = ts.strftime("%Y-%m-%d-%H%M%S")
    app_name = get_frontmost_app()

    preview = sanitize_filename(text, 40)
    tag_suffix = f"-{'-'.join(tags)}" if tags else ""
    filename = f"{ts_file}{tag_suffix}-{preview}.md"
    filepath = dir_path / filename

    hex_color = VALID_COLORS[color]
    comment_section = f"\n📝 **注释**: {comment}\n" if comment else ""
    url_section = f"\n🔗 **来源**: [{source_url}]({source_url})\n" if source_url else ""
    tag_line = f"\nTags: {', '.join(tags)}" if tags else ""

    content = f"""---
date: {date_str}
time: {time_str}
timestamp: {timestamp_str}
source_app: {app_name}
source_url: "{source_url or ''}"
color: {color}
hex_color: {hex_color}
tags: [{', '.join(tags)}]
comment: "{comment or ''}"
---

## <span style="background-color:{hex_color};padding:2px 6px;border-radius:3px">📌 Highlight</span>

> {text}
{comment_section}{url_section}
---
*Saved from **{app_name}** at {time_str}*{tag_line}
"""

    filepath.write_text(content.strip() + "\n")

    # Save tag index
    TAGS_DIR.mkdir(parents=True, exist_ok=True)
    for tag in tags:
        tag_file = TAGS_DIR / f"{tag}.txt"
        with open(tag_file, 'a') as f:
            f.write(f"{ts_file} {text[:80]}\n")

    return filepath, f"✓ Saved {color} highlight ({len(text)} chars) from {app_name}"


def parse_highlight_file(fp):
    """Parse a highlight markdown file into a dict."""
    try:
        content = fp.read_text(encoding='utf-8')
    except Exception:
        return None

    result = {
        'path': str(fp),
        'filename': fp.name,
        'mtime': datetime.datetime.fromtimestamp(fp.stat().st_mtime).strftime("%Y-%m-%d %H:%M"),
    }

    # Parse YAML frontmatter
    fm_match = re.match(r'^---\s*\n(.*?)\n---\s*\n(.*)', content, re.DOTALL)
    if fm_match:
        fm_text = fm_match.group(1)
        body = fm_match.group(2)
        # Parse key: value pairs
        for line in fm_text.split('\n'):
            m = re.match(r'^(\w+):\s*(.*)', line)
            if m:
                key = m.group(1)
                val = m.group(2).strip().strip('"\'')
                result[key] = val

        # Extract the quote (highlighted text) - find blockquote line
        qm = re.search(r'(?:\n|^)> (.+?)(?:\n|$)', body)
        if qm:
            result['quote'] = qm.group(1).strip()

        # Extract comment
        cm = re.search(r'📝\s*\*\*(?:注释|Note)\*\*:\s*(.+?)(?:\n|$)', body)
        if cm:
            result['comment'] = cm.group(1).strip()

        # Extract URL
        um = re.search(r'🔗\s*\*\*(?:来源|Source)\*\*:\s*\[(.+?)\]\((.+?)\)', body)
        if um:
            result['source_url'] = um.group(2)

    # Defaults
    result.setdefault('color', 'yellow')
    result.setdefault('hex_color', VALID_COLORS.get(result['color'], '#FFF176'))
    result.setdefault('quote', fp.stem[:80])
    result.setdefault('source_app', 'Unknown')
    result.setdefault('tags', '[]')
    result.setdefault('comment', '')
    result.setdefault('source_url', '')

    return result


def get_all_highlights(limit=100):
    """Get all highlights sorted by time (newest first)."""
    files = sorted(
        HIGHLIGHTS_DIR.rglob('*.md'),
        key=lambda p: p.stat().st_mtime,
        reverse=True
    )
    results = []
    for fp in files[:limit]:
        h = parse_highlight_file(fp)
        if h:
            results.append(h)
    return results


def search_highlights(query):
    results = []
    if not query:
        return results
    try:
        cmd = ['mdfind', '-onlyin', str(HIGHLIGHTS_DIR), query]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        if proc.returncode == 0:
            for f in proc.stdout.strip().split('\n'):
                if not f:
                    continue
                fp = Path(f)
                if fp.exists():
                    h = parse_highlight_file(fp)
                    if h:
                        results.append(h)
    except Exception:
        pass
    return results


def list_highlights(n=10):
    files = sorted(
        HIGHLIGHTS_DIR.rglob('*.md'),
        key=lambda p: p.stat().st_mtime,
        reverse=True
    )
    results = []
    for fp in files[:n]:
        h = parse_highlight_file(fp)
        if h:
            results.append(h)
    return results


def print_results(results, label="Results"):
    if not results:
        print("No results found.")
        return

    print(f"\n{label}:\n")
    for i, r in enumerate(results, 1):
        color_dot = "●"
        c = r.get('color', 'yellow')
        quote = r.get('quote', '')[:70]
        comment = r.get('comment', '')
        app = r.get('source_app', '')
        mtime = r.get('mtime', '')
        print(f"  [{i}] {color_dot} {mtime}  [{c}] {quote}")
        if comment:
            print(f"       💬 {comment[:60]}")
        print(f"       📄 {r['path']}")
        print()


def print_stats():
    files = list(HIGHLIGHTS_DIR.rglob('*.md'))
    tags = list(TAGS_DIR.glob('*.txt'))

    months = Counter()
    colors = Counter()
    for fp in files:
        ts = fp.stat().st_mtime
        dt = datetime.datetime.fromtimestamp(ts)
        months[f"{dt.year}-{dt.month:02d}"] += 1
        h = parse_highlight_file(fp)
        if h:
            colors[h.get('color', 'yellow')] += 1

    print(f"\n📊 Highlights Statistics")
    print(f"{'='*50}")
    print(f"  Total highlights: {len(files)}")
    print(f"  Total tags:       {len(tags)}")
    print()
    if colors:
        print("  By color:")
        for col, count in sorted(colors.items(), key=lambda x: -x[1]):
            dot = "🟡🟢🔴🔵🟣🟠🟤".split("🟡🟢🔴🔵🟣🟠🟤")
            idx = list(VALID_COLORS.keys()).index(col) if col in VALID_COLORS else 0
            emoji = ["🟡","🟢","🔵","🔴","🟣","🟠","🟥"][idx] if idx < 7 else "🟡"
            bar = "█" * min(count, 20)
            print(f"    {emoji} {col}: {bar} ({count})")
    print()
    if months:
        print("  By month:")
        for month, count in sorted(months.items(), reverse=True)[:12]:
            bar = "█" * min(count, 30)
            print(f"    {month}: {bar} ({count})")


