    }).join('');
}

function parseTags(tagsStr) {
    if (!tagsStr) return '';
    try {
        const arr = JSON.parse(tagsStr);
        if (!arr.length) return '';
        return arr.map(t => {
            const cls = ['blue','green','purple','orange'][Math.abs(hash(t)) % 4];
            return `<span class="tag ${cls}">${escapeHtml(t)}</span>`;
        }).join('');
    } catch(e) {
        return '';
    }
}

function hash(s) {
    let h = 0;
    for (let i = 0; i < s.length; i++) {
        h = ((h << 5) - h) + s.charCodeAt(i);
        h |= 0;
    }
    return h;
}

function escapeHtml(s) {
