def start_server():
    """Start the web UI server."""
    import threading

    highlights_json_path = HIGHLIGHTS_DIR / ".cache" / "highlights.json"

    class HighlightHandler(http.server.SimpleHTTPRequestHandler):
        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)

            if parsed.path == '/':
                self.send_response(200)
                self.send_header('Content-Type', 'text/html; charset=utf-8')
                self.end_headers()
                self.wfile.write(WEB_HTML.encode('utf-8'))

            elif parsed.path == '/api/highlights':
                self.send_response(200)
                self.send_header('Content-Type', 'application/json; charset=utf-8')
                self.send_header('Access-Control-Allow-Origin', '*')
                self.end_headers()
                highlights = get_all_highlights(limit=500)
                latest = highlights[0]['mtime'] if highlights else 'N/A'
                data = json.dumps({
                    'highlights': highlights,
                    'total': len(highlights),
                    'latest': latest,
                    'colors': list(VALID_COLORS.keys()),
                }, ensure_ascii=False)
                self.wfile.write(data.encode('utf-8'))

            else:
                self.send_response(404)
                self.end_headers()
                self.wfile.write(b'Not found')

        def log_message(self, format, *args):
            pass  # Suppress logs

    # Find a free port
    port = WEB_PORT
    for attempt in range(10):
        try:
            server = socketserver.TCPServer(("", port), HighlightHandler)
            break
        except OSError:
            port += 1
    else:
        print("❌ Could not find a free port")
        return

    print(f"\n🌐 Highlights Web UI: http://localhost:{port}")
    print(f"   📁 Data from: {HIGHLIGHTS_DIR}")
    print(f"   Press Ctrl+C to stop\n")

    # Open browser
    webbrowser.open(f'http://localhost:{port}')

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n👋 Server stopped.")
        server.shutdown()


