    grid.innerHTML = items.map(h => {
        const c = h.color || 'yellow';
        const style = COLORS[c] || COLORS.yellow;
        const tags = parseTags(h.tags);
        const time = h.mtime || '';
        const app = h.source_app || '';
        const url = h.source_url || '';
