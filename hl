def cmd_save(args, tags=None, color=None, comment=None, source_url=None):
    text = None

    if args:
        text = ' '.join(args)

    if not text and not sys.stdin.isatty():
        try:
            text = sys.stdin.read().strip()
        except Exception:
            pass

    if not text:
        text = get_clipboard()

    if not text:
        print("No text provided. Options:")
        print("  hl -c yellow -m \"note\" \"text\"")
        print("  echo \"text\" | hl")
        print("  hl   (reads clipboard)")
        return

    filepath, msg = save_highlight(text, tags, color, comment, source_url)
    if filepath:
        color_dot = "●"
        print(f"\n✅ {msg}")
        print(f"   📄 {filepath}")
        notify("Highlight Saved", f"{color} • {len(text)} chars")
    else:
        print(f"\n❌ {msg}")


def parse_args():
    tags = []
    color = None
    comment = None
    source_url = None
    args = sys.argv[1:]
    cmd = None
    positional = []
    i = 0
    while i < len(args):
        if args[i] in ('-h', '--help'):
            print(__doc__)
            sys.exit(0)
        elif args[i] == '-t' and i + 1 < len(args):
            tags = [t.strip() for t in args[i+1].split(',')]
            i += 2
        elif args[i] in ('-c', '--color') and i + 1 < len(args):
            color = args[i+1].lower()
            i += 2
        elif args[i] in ('-m', '--comment') and i + 1 < len(args):
            comment = args[i+1]
            i += 2
        elif args[i] == '--url' and i + 1 < len(args):
            source_url = args[i+1]
            i += 2
        elif cmd is None and args[i] in ('save', 'search', 'list', 'today', 'stats', 'open', 'help', 'server'):
            cmd = args[i]
            i += 1
        else:
            positional.append(args[i])
            i += 1
    return cmd or 'save', tags, color, comment, source_url, positional


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ('-h', '--help'):
        print(__doc__)
        return

    cmd, tags, color, comment, source_url, positional = parse_args()

    if cmd == 'save':
        cmd_save(positional, tags, color, comment, source_url)

    elif cmd == 'server':
        server_script = Path.home() / "scripts" / "hl-server.py"
        os.execv(sys.executable, [sys.executable, str(server_script)])

    elif cmd == 'search':
        query = ' '.join(positional) if positional else None
        if not query:
            query = input("Search query: ").strip()
        if query:
            print(f"\n🔍 Searching for: {query}\n")
            results = search_highlights(query)
            print_results(results, f"Search results for '{query}'")
        else:
            print("No search query provided.")

    elif cmd == 'list':
        n = int(positional[0]) if positional and positional[0].isdigit() else 10
        results = list_highlights(n)
        print_results(results, f"Recent highlights (last {n})")

    elif cmd == 'today':
        today = datetime.date.today().strftime("%Y-%m-%d")
        results = [
            h for h in get_all_highlights(limit=500)
            if today in h.get('mtime', '') or today in h.get('date', '')
        ]
        print_results(results, f"Today's highlights ({len(results)})")

    elif cmd == 'stats':
        print_stats()

    elif cmd == 'open':
        subprocess.run(['open', str(HIGHLIGHTS_DIR)])

    elif cmd == 'help':
        print(__doc__)


if __name__ == '__main__':
    main()
