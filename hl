}

function render(items) {
    const grid = document.getElementById('card-grid');
    if (!items.length) {
        grid.innerHTML = `<div class="empty-state"><h2>📭 没有找到高亮</h2><p>试试: hl -c yellow "你的文字"</p></div>`;
